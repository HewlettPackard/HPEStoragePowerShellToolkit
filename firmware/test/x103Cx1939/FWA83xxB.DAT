;Document number: ??
;Document Description: FwArea DATA for standard FC cards
;
;APPLICATION: ISP83xx standard FC cards
;
;Revision History:
; REV      DATE      WHO  ER#    DESCRIPTION OF CHANGE
;--------  --------  ---  -----  ------------------------------------------
; 1.00.00  08-26-11  kkc  xxxxx  Initial version for ISP83xx (non-SR-IOV)
; 1.00.01  08-31-11  kkc  xxxxx  Add TLP nullification
;                         xxxxx  FC: powerdown NIC blocks
; 1.01.00  09-07-11  kkc  85822  FC: turn off laser on all resets.
;                    kkc  85824  FC: Reset Hoover PLL on Hard resets.
; 1.02.00  09-19-11  kkc  86151  Tune 1us clock count (chg to A3h)
; 1.03.00  10-04-11  kkc  86502  Disable SR-IOV
;                         86503  Disable ASPM
; 1.04.00  11-17-11  kkc  87769  FC: Disable Gen 3.
; 1.05.00  12-07-11  kkc  88230  FC: Configure PCIe serdes parameters.
; 1.05.02  12-14-11  kkc  88445  FCoE: Remove Device ID workaround
;                                (Requires PegTune to load device ID)
; 1.06.00  12-22-11  kkc  88645  FC: Enable 256 queues and set MEMBAR2 = 1MB
;                                FCoE: Enable 256 queues (PegTune sets MEMBAR)
;                    gth  88622  FC: Set LEDs to match FW Spec reset values.
; 1.06.02  12-22-11  kkc  -----  back out ER88645 (needs more verification)
; 1.06.04  01-10-12  kkc  -----  back out ER88622 until B0.
; 1.07.00  01-20-12  kkc  88645  FC: Restore 256 queues and MEMBAR2 = 1MB
;                                FCoE: Enable 256 queues (PegTune sets MEMBAR)
; 1.07.02  02-10-12  kkc  90256  FCoE: Remove setup of VPD address
; 2.00.00  02-24-12  kkc  90679  Add entries for tunable PCIe serdes params
;                         90363  Set Octavo LOSTRIM and toggle AZRST
;                         90564  Remove DSN setup from FC preload.
; 2.01.00  05-16-12  kkc  93253  Enable PEG0+ blocks (MCTP config)
; 2.01.02  06-20-12  kkc  92635  Reload FCoE BIOS BAR on every reset
; 3.01.00  06-21-12  kkc  93521  B0 table: Set LEDs to match spec.
;                                          Remove 1us tuning
;                                          Remove A0 PCIe workarounds
;                                          Remove Device ID workaround
; 3.01.01  07-10-12  kkc  95547  Add B0 changes, phase 2
;                                    o De-emphasis fix
;                                    o FASTADAPT changes
;                                    o Lease ASPM enabled
;                                    o Remove Hoover PLL Reset
;                                    o Leave Gen3 enabled
;                         95548  Disable PBUS related function specific
;                                entries if function is disabled
;                         95565  Add a "Supported revisions" bit mask field
; 3.01.02  10-23-12  kkc  99971  FC: Disable ATS capability
;                        100019  FC: Disable TPH, OBFF, LTR
; 3.01.03  11-11-12  KKC 100497  FC: Configure RTSEL_FC_1/2 as input
; 3.01.05  12-09-13  kkc 114017  FC: Set PCIe PLL LDO LD0 voltage = 1.1V
;                                Toggle PLL mult to cause recalibration.
;                                Disable DDR3 buffers
;
; Numbers are in hexadecimal. File can also contain comments.
;
;*******************************************************************
;!!!!!!!!!!     DO NOT CHANGE THE ORDER OF THE DATA     !!!!!!!!!!!!
;*******************************************************************
;
; Default Base Address = 7FA6_0000
;***************************************************
; FW Area header                 (BYTE OFFSET 0000h)
;***************************************************
FWA Signature            [0-FFFFFFFFh] = CABA8030

Test Version Number            [0-FFh] = 0
SubMinor Version Number        [0-FFh] = 5
Minor Version Number           [0-FFh] = 1
Major Version Number           [0-FFh] = 3

FW Area Options          [0-FFFFFFFFh] = 2
Auto Load Flags          [0-FFFFFFFFh] = 0
Flash Sema T.O. (us)     [0-FFFFFFFFh] = 0
FCoE Preload Addr        [0-FFFFFFFFh] = 7FA6001F
FC Preload Addr          [0-FFFFFFFFh] = 7FA6054F
Soft ROM Addr            [0-FFFFFFFFh] = 0
Tail Signature Addr      [0-FFFFFFFFh] = 7FA60A7D

;***************************************************
; File Information               (BYTE OFFSET 0024h)
;***************************************************
; FCoE Attributes:
;	bit 31	= No-NIC FCoE
;	bit 30  = FC only
;	bit 1	= SR-IOV supported
;	bit 0	= Ext MSI-X supported
;---------------------------------------------------
FCoE Attributes          [0-FFFFFFFFh] = 40000000
Num FCoE MSIX vectors        [0-FFFFh] = 10
Num FCoE VFs                 [0-FFFFh] = 0
Num MSIX vectors per VF      [0-FFFFh] = 0
reserved                     [0-FFFFh] = 0
reserved                 [0-FFFFFFFFh] = 0
reserved                 [0-FFFFFFFFh] = 0
reserved                 [0-FFFFFFFFh] = 0

reserved                 [0-FFFFFFFFh] = 0
reserved                 [0-FFFFFFFFh] = 0
reserved                 [0-FFFFFFFFh] = 0
reserved                 [0-FFFFFFFFh] = 0

